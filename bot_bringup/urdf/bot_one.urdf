<?xml version="1.0" ?>
<robot name="Jeevan" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="scale" value="0.5"/>

  <link name="base_footprint">
    <visual>
      <origin xyz="0.0 0.0 0.015" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${0.1 * scale} ${0.1 * scale} ${0.1 * scale}"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="${0.15 * scale} 0.0 ${0.15 * scale}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${0.75 * scale} ${0.4 * scale} ${0.1 * scale}"/>
      </geometry>
      <material name="gray">
        <color rgba=".2 .2 .2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${0.75 * scale} ${0.4 * scale} ${0.1 * scale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="wheel_right_link">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="${0.15 * scale}" length="${0.1 * scale}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="${0.15 * scale}" length="${0.1 * scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 ${-0.25 * scale} ${0.15 * scale}" rpy="-1.57 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
  </joint>

  <link name="wheel_left_link">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="${0.15 * scale}" length="${0.1 * scale}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="${0.15 * scale}" length="${0.1 * scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="0.0 ${0.25 * scale} ${0.15 * scale}" rpy="-1.57 0.0 0.0"/>
    <parent link="base_footprint"/>
    <child link="wheel_left_link"/>
    <axis xyz="0.0 0.0 1.0"/>
  </joint>

  <link name="caster">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="${0.081 * scale}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="${0.081 * scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_joint" type="continuous">
    <origin xyz="${0.45 * scale} 0.0 ${0.076 * scale}" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <parent link="base_footprint"/>
    <child link="caster"/>
  </joint>

  <link name="laser">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="${0.05 * scale}" length="${0.05 * scale}"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${0.08 * scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="${0.525 * scale} 0.0 ${0.225 * scale}" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <parent link="base_footprint"/>
    <child link="laser"/>
  </joint>

  <material name="gray"><color rgba=".2 .2 .2 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="blue"><color rgba="0.2 0.2 1 1"/></material>
  <material name="brown"><color rgba="0.6 0.4 0 1"/></material>

  <gazebo>
    <plugin
        filename="ignition-gazebo-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <tf_topic>/tf</tf_topic>
        <wheel_separation>${0.5 * scale}</wheel_separation>
        <wheel_radius>${0.15 * scale}</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>
        <max_linear_acceleration>1</max_linear_acceleration>
        <min_linear_acceleration>-1</min_linear_acceleration>
        <max_angular_acceleration>2</max_angular_acceleration>
        <min_angular_acceleration>-2</min_angular_acceleration>
        <max_linear_velocity>0.5</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1</max_angular_velocity>
        <min_angular_velocity>-1</min_angular_velocity>
      </plugin>
  </gazebo>

  <gazebo reference="laser">
    <sensor type="gpu_lidar" name="laser">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.1</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="${0.05 * scale} ${0.05 * scale} ${0.05 * scale}"/>
      </geometry>
      <material name="brown">
        <color rgba="0.6 0.4 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${0.05 * scale} ${0.05 * scale} ${0.05 * scale}"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <axis xyz="0.0 0.0 0.0"/>
    <parent link="base_footprint"/>
    <child link="camera_link"/>
    <origin xyz="${0.545 * scale} 0.0 ${0.275 * scale}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="camera" name="camera">
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <topic>/image_raw</topic>
      <camera name="camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>720</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>300</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
